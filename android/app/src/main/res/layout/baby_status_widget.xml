<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/baby_status_widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="Uygulamayı açın"
        android:textColor="#2F3A4A"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="28dp"
                android:layout_height="24dp"
                android:background="@drawable/baby_status_widget_badge"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_baby_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="GÜNLÜK ÖZET"
                android:textColor="#28758A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_day_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bugün"
                android:textColor="#4B5563"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_feeding_row"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/baby_status_widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/baby_status_widget_circle_blue"
                android:contentDescription="@string/widget_feeding"
                android:padding="9dp"
                android:src="@drawable/ic_widget_feeding"
                android:tint="#28758A" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Son Beslenme"
                    android:textColor="#4B5563"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_feeding_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="#2F3A4A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_feed_60"
                        style="@style/BabyWidgetChip"
                        android:text="60" />

                    <TextView
                        android:id="@+id/widget_feed_90"
                        style="@style/BabyWidgetChip"
                        android:layout_marginStart="5dp"
                        android:text="90" />

                    <TextView
                        android:id="@+id/widget_feed_120"
                        style="@style/BabyWidgetChip"
                        android:layout_marginStart="5dp"
                        android:text="120" />

                    <TextView
                        android:id="@+id/widget_feed_other"
                        style="@style/BabyWidgetChip"
                        android:layout_marginStart="5dp"
                        android:text="Diğer" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_feeding_value"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="#28758A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_diaper_row"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/baby_status_widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/baby_status_widget_circle_lavender"
                android:contentDescription="@string/widget_diaper"
                android:padding="9dp"
                android:src="@drawable/ic_widget_diaper"
                android:tint="#6E4F7C" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Son Bez Değişimi"
                    android:textColor="#4B5563"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_diaper_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="#2F3A4A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_diaper_wet"
                        style="@style/BabyWidgetChip"
                        android:text="Islak" />

                    <TextView
                        android:id="@+id/widget_diaper_dirty"
                        style="@style/BabyWidgetChip"
                        android:layout_marginStart="5dp"
                        android:text="Kirli" />

                    <TextView
                        android:id="@+id/widget_diaper_both"
                        style="@style/BabyWidgetChip"
                        android:layout_marginStart="5dp"
                        android:text="Karışık" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/widget_diaper_value"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="#6E4F7C"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_sleep_area"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/baby_status_widget_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_sleep_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Uyku"
                    android:textColor="#4B5563"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_sleep_total"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0dk / 14s"
                    android:textColor="#28758A"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_sleep_action"
                android:layout_width="132dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/baby_status_widget_action"
                android:gravity="center"
                android:text="Uyku Başladı"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/widget_sleep_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/baby_status_widget_progress" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
